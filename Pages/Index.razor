@page "/"
@inject IStringLocalizer<SharedResources> Localizer
@inject CultureService CultureService

@*<h1 class="pb-2">TRI產線-線上派工系統</h1>*@
<div class="pb-2">
    <div class="d-flex justify-content-end pb-3">
        <label class="me-2">@Localizer["SelectLanguage"]:</label>
        <select @onchange="OnCultureChanged" class="form-select" style="width: auto;">
            @foreach (var culture in CultureService.SupportedCultures)
            {
                <option value="@culture.Name" selected="@(culture.Name == CultureService.CurrentCulture.Name)">
                    @Localizer[culture.Name == "zh-TW" ? "TraditionalChinese" : "English"]
                </option>
            }
        </select>
    </div>

<p class="pb-2 mw-1100">
    @*<img class="fit-width" src="images/Robot-poster.jpg" style="height: 36%; width: 36%; float:left" >*@
    <h5 class="pb-2">&emsp;&emsp;&emsp;@Localizer["OnlineWorkReporting"]<br></h5>
    <h5 class="pb-2">&emsp;&emsp;&emsp;@Localizer["SystemDescription"]<br></h5>
    <h5 class="pb-2">&emsp;&emsp;&emsp;@Localizer["SystemFeatures"]<br></h5>
    <h5 class="pb-2">&emsp;&emsp;&emsp;@Localizer["Feature1"]<br></h5>
    <h5 class="pb-2">&emsp;&emsp;&emsp;@Localizer["Feature2"]<br></h5>
    <h5 class="pb-2">&emsp;&emsp;&emsp;@Localizer["Feature3"]<br></h5>
    <h5 class="pb-2">&emsp;&emsp;&emsp;@Localizer["Feature4"]<br></h5>
    <h5 class="pb-2">&emsp;&emsp;&emsp;@Localizer["Feature5"]<br></h5>
    <h5 class="pb-2">&emsp;&emsp;&emsp;@Localizer["SystemBenefits"]<br></h5>

    <h5 class="pb-2">&emsp;&emsp;&emsp;@Localizer["OnlineSOP"]<br></h5>
    <img>
</p>
</div>
<div class="pb-2">
    <img class="fit-width" src="images/Techman Robot.png" style="height: 24%; width: 24%; float:right" align="bottom" />
</div>
@*<h2 class="mb-4 mt-4">Helpful Resources</h2>*@

<ul>
