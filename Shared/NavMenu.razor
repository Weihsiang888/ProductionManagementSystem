@using Microsoft.Extensions.Localization
@inject IStringLocalizer<NavMenu> Localizer

<div class="sidebar @StateCssClass">
    <DxTreeView AllowSelectNodes="true" CssClass="app-sidebar">
    <Nodes>
        <DxTreeViewNode NavigateUrl="./" Text="@Localizer["Home"]"></DxTreeViewNode>
        <DxTreeViewNode NavigateUrl="OperatorInformation" Text="@Localizer["OperatorInformation"]"></DxTreeViewNode>
        <DxTreeViewNode NavigateUrl="OperatorAbilityPage" Text="@Localizer["OperatorAbility"]"></DxTreeViewNode>
        <DxTreeViewNode NavigateUrl="TimePeriod" Text="@Localizer["TimePeriod"]"></DxTreeViewNode>
        <DxTreeViewNode NavigateUrl="OvertimeSchedule" Text="@Localizer["OvertimeSchedule"]"></DxTreeViewNode>
        <DxTreeViewNode NavigateUrl="WorkingTypeGroup" Text="@Localizer["WorkingStation"]"></DxTreeViewNode>
        <DxTreeViewNode NavigateUrl="WorkingType" Text="@Localizer["WorkingProcedure"]"></DxTreeViewNode>
        @*<DxTreeViewNode NavigateUrl="WorkingList" Text="@Localizer["WorkingAssignment"]"></DxTreeViewNode>*@
        <DxTreeViewNode NavigateUrl="WorkingListRobotAssembly">
                <TextTemplate>
                    <b>@((MarkupString)Localizer["RobotAssembly"].Value)</b>
                </TextTemplate>
        </DxTreeViewNode>
        <DxTreeViewNode NavigateUrl="WorkingResponsePage/Detail" Text="@Localizer["OnlineReport"]"></DxTreeViewNode>
        <DxTreeViewNode NavigateUrl="WorkingReportPage">
                <TextTemplate>
                    <b>@((MarkupString)Localizer["WorkingDetail"].Value)</b>
                </TextTemplate>
        </DxTreeViewNode>
        <DxTreeViewNode NavigateUrl="StatisticReport" Text="@Localizer["StatisticReport"]"></DxTreeViewNode>
        <DxTreeViewNode NavigateUrl="OperatorReport" Text="@Localizer["OperatorReport"]"></DxTreeViewNode>
    </Nodes>
</DxTreeView>
</div>

@code {
    [Parameter] public string? StateCssClass { get; set; }
}