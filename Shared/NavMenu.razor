@inject IStringLocalizer<SharedResources> L

<div class="sidebar @StateCssClass">
    <DxTreeView AllowSelectNodes="true" CssClass="app-sidebar">
    <Nodes>
        <DxTreeViewNode NavigateUrl="./" Text='@L["NavHome"]'></DxTreeViewNode>
        <DxTreeViewNode NavigateUrl="OperatorInformation" Text='@L["NavOperatorInfo"]'></DxTreeViewNode>
        <DxTreeViewNode NavigateUrl="OperatorAbilityPage" Text='@L["NavOperatorAbility"]'></DxTreeViewNode>
        <DxTreeViewNode NavigateUrl="TimePeriod" Text='@L["NavTimePeriod"]'></DxTreeViewNode>
        <DxTreeViewNode NavigateUrl="OvertimeSchedule" Text='@L["NavOvertimeSchedule"]'></DxTreeViewNode>
        <DxTreeViewNode NavigateUrl="WorkingTypeGroup" Text='@L["NavWorkingTypeGroup"]'></DxTreeViewNode>
        <DxTreeViewNode NavigateUrl="WorkingType" Text='@L["NavWorkingType"]'></DxTreeViewNode>
        @*<DxTreeViewNode NavigateUrl="WorkingList" Text="產線人員派工作業"></DxTreeViewNode>*@
        <DxTreeViewNode NavigateUrl="WorkingListRobotAssembly">
                <TextTemplate>
                    <b>@L["NavWorkingListRobotAssembly"]</b>
                </TextTemplate>
        </DxTreeViewNode>
        <DxTreeViewNode NavigateUrl="WorkingResponsePage/Detail" Text='@L["NavWorkingResponse"]'></DxTreeViewNode>
        <DxTreeViewNode NavigateUrl="WorkingReportPage">
                <TextTemplate>
                    <b>@L["NavWorkingReport"]</b>
                </TextTemplate>
        </DxTreeViewNode>
        <DxTreeViewNode NavigateUrl="StatisticReport" Text='@L["NavStatisticReport"]'></DxTreeViewNode>
        <DxTreeViewNode NavigateUrl="OperatorReport" Text='@L["NavOperatorReport"]'></DxTreeViewNode>
    </Nodes>
</DxTreeView>
</div>

@code {
    [Parameter] public string? StateCssClass { get; set; }
}