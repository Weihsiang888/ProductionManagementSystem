@inject IStringLocalizer<SharedResources> Localizer

<div class="sidebar @StateCssClass">
    <DxTreeView AllowSelectNodes="true" CssClass="app-sidebar">
    <Nodes>
        <DxTreeViewNode NavigateUrl="./" Text="@Localizer["Nav_Home"]"></DxTreeViewNode>
        <DxTreeViewNode NavigateUrl="OperatorInformation" Text="@Localizer["Nav_OperatorInformation"]"></DxTreeViewNode>
        <DxTreeViewNode NavigateUrl="OperatorAbilityPage" Text="@Localizer["Nav_OperatorAbility"]"></DxTreeViewNode>
        <DxTreeViewNode NavigateUrl="TimePeriod" Text="@Localizer["Nav_TimePeriod"]"></DxTreeViewNode>
        <DxTreeViewNode NavigateUrl="OvertimeSchedule" Text="@Localizer["Nav_OvertimeSchedule"]"></DxTreeViewNode>
        <DxTreeViewNode NavigateUrl="WorkingTypeGroup" Text="@Localizer["Nav_WorkingTypeGroup"]"></DxTreeViewNode>
        <DxTreeViewNode NavigateUrl="WorkingType" Text="@Localizer["Nav_WorkingType"]"></DxTreeViewNode>
        @*<DxTreeViewNode NavigateUrl="WorkingList" Text="產線人員派工作業"></DxTreeViewNode>*@
        <DxTreeViewNode NavigateUrl="WorkingListRobotAssembly">
                <TextTemplate>
                    <b>@Localizer["Nav_WorkingListRobotAssembly"]<br />RobotAssembly</b>
                </TextTemplate>
        </DxTreeViewNode>
        <DxTreeViewNode NavigateUrl="WorkingResponsePage/Detail" Text="@Localizer["Nav_WorkingResponse"]"></DxTreeViewNode>
        <DxTreeViewNode NavigateUrl="WorkingReportPage">
                <TextTemplate>
                    <b>@Localizer["Nav_WorkingReport"]<br />Report</b>
                </TextTemplate>
        </DxTreeViewNode>
        <DxTreeViewNode NavigateUrl="StatisticReport" Text="@Localizer["Nav_StatisticReport"]"></DxTreeViewNode>
        <DxTreeViewNode NavigateUrl="OperatorReport" Text="@Localizer["Nav_OperatorReport"]"></DxTreeViewNode>
    </Nodes>
</DxTreeView>
</div>

@code {
    [Parameter] public string? StateCssClass { get; set; }
}
