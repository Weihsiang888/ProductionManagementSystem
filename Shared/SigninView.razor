@inject IStringLocalizer<SharedResources> Localizer

<AuthorizeView>
    <Authorized>
        <span>
            <b>@Localizer["Hello"], @context.User.Identity.Name! </b>
            <a class="ml-md-auto btn btn-primary" href="/Logout" target="_top"> @Localizer["Logout"] </a>
        </span>
    </Authorized>
    <NotAuthorized>
        <a class="ml-md-auto btn btn-primary" href="/Login" target="_top"> @Localizer["Login"] </a>
    </NotAuthorized>
</AuthorizeView>

@code {

}