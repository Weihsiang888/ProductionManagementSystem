@inject NavigationManager nav
@inject IStringLocalizer<SharedResources> L

<div class="language-switcher">
    <button class="btn btn-sm btn-outline-secondary me-1" @onclick='() => SwitchLanguage("zh-TW")'>@L["LanguageSwitcher_ZhTW"]</button>
    <button class="btn btn-sm btn-outline-secondary" @onclick='() => SwitchLanguage("en")'>@L["LanguageSwitcher_En"]</button>
</div>

@code {
    private void SwitchLanguage(string culture)
    {
        var uri = nav.ToAbsoluteUri(nav.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        query["culture"] = culture;
        query["ui-culture"] = culture;
        var newUrl = uri.GetLeftPart(UriPartial.Path) + "?" + query.ToString();
        nav.NavigateTo(newUrl, forceLoad: true);
    }
}
