@using Microsoft.AspNetCore.Localization
@using System.Globalization
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<div class="language-switcher">
    <select class="form-select" @onchange="OnLanguageChanged" value="@currentCulture">
        <option value="zh-TW">繁體中文</option>
        <option value="en">English</option>
    </select>
</div>

@code {
    private string currentCulture = CultureInfo.CurrentCulture.Name;

    protected override void OnInitialized()
    {
        currentCulture = CultureInfo.CurrentCulture.Name;
    }

    private async Task OnLanguageChanged(ChangeEventArgs e)
    {
        var culture = e.Value?.ToString();
        if (!string.IsNullOrEmpty(culture))
        {
            // Set cookie using dedicated JavaScript helper function
            var cookieValue = $"c={culture}|uic={culture}";
            await JSRuntime.InvokeVoidAsync("CultureHelper.setCookie", ".AspNetCore.Culture", cookieValue, 365);

            // Reload the page to apply the new culture
            Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
        }
    }
}

<style>
    .language-switcher {
        padding: 10px;
    }

    .language-switcher select {
        width: auto;
        display: inline-block;
    }
</style>
