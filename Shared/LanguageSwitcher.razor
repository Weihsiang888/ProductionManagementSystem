@inject NavigationManager NavigationManager
@using Microsoft.AspNetCore.WebUtilities

<div class="language-switcher">
    <button class="btn btn-sm btn-outline-secondary me-1" @onclick='() => SwitchLanguage("zh-TW")'>繁體中文</button>
    <button class="btn btn-sm btn-outline-secondary" @onclick='() => SwitchLanguage("en")'>English</button>
</div>

@code {
    private void SwitchLanguage(string culture)
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var queryParams = QueryHelpers.ParseQuery(uri.Query);
        queryParams["culture"] = culture;
        queryParams["ui-culture"] = culture;
        var newQuery = string.Join("&", queryParams.Select(kvp =>
            $"{Uri.EscapeDataString(kvp.Key)}={Uri.EscapeDataString(kvp.Value.FirstOrDefault() ?? string.Empty)}"));
        var newUrl = uri.GetLeftPart(UriPartial.Path) + "?" + newQuery;
        NavigationManager.NavigateTo(newUrl, forceLoad: true);
    }
}
